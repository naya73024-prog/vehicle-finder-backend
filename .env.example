NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=vehicle_finder
DB_POOL_MAX=10
DB_TIMEOUT_MS=5000
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
PUBLIC_BASE_URL=http://localhost:3000
# Frontend reads ?token=... and POSTs {token,newPassword} to /api/auth/reset-password.
PASSWORD_RESET_URL=http://localhost:5173/reset-password
CORS_ORIGINS=http://localhost:5173
# disabled is development only; sending returns 503 until configured.
EMAIL_PROVIDER=disabled
EMAIL_FROM=Vehicle Finder <noreply@your-verified-domain.com>
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=your-resend-api-key
# Or EMAIL_PROVIDER=smtp (Render free blocks common SMTP ports):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
